{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>krosoft-dev/krosoft-tooling-renovate:react"],
  "description": "Renovate configuration for lovable projects.",
  "packageRules": [
    {
      "groupName": "UI Components",
      "matchPackageNames": ["class-variance-authority", "sonner"]
    },
    {
      "groupName": "Tiptap packages",
      "matchPackagePatterns": ["^@tiptap/"]
    },
    {
      "groupName": "Turf packages",
      "matchPackagePatterns": ["^@turf/"]
    },
    {
      "groupName": "D3 packages",
      "matchPackagePatterns": ["^d3-", "^@types/d3-"]
    }
  ]
}
